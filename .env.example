# claw-auth-proxy environment template
#
# This file is shaped for the Docker Compose deployment and can be copied to a
# staging host using cloud Supabase. Replace every value marked "change-me".
#
# Local Docker-only note:
# - For cloud Supabase, leave SUPABASE_DOCKER_URL unset.
# - For local Supabase running on the Docker host, set SUPABASE_DOCKER_URL to
#   http://host.docker.internal:54321 and keep SUPABASE_PUBLIC_URL as the URL
#   browsers should open.

# --- Supabase ---
# Cloud Supabase URL used by the proxy for Auth, REST, and Storage.
SUPABASE_URL=http://127.0.0.1:54321

# Browser-facing Supabase URL used in signed Storage export links.
# In cloud/staging this is normally the same as SUPABASE_URL.
SUPABASE_PUBLIC_URL=http://localhost:54321

# Local-only override for proxy-container-to-host Supabase connectivity.
SUPABASE_DOCKER_URL=http://host.docker.internal:54321

SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
TOKEN_ENCRYPTION_KEY=your_token_encryption_key_here

# --- Proxy / browser surface ---
# Frontend origins allowed to call the proxy from a browser.
# Use comma-separated origins when staging has both app and preview frontends.
ALLOWED_ORIGINS=http://localhost:8000,https://frolicking-lollipop-74e82c.netlify.app
ALLOWED_ORIGIN_REGEX=
LOG_LEVEL=INFO

# Compose image/port controls.
CLAW_PROXY_IMAGE=lifeatlas/claw-proxy:latest
CLAW_PROXY_PORT=8000

# --- ZeroClaw activation and image ---
# TOKEN_ENCRYPTION_KEY is both the Fernet passphrase for container tokens and
# the feature flag that mounts /zeroclaw/* and /claw-admin/*.


# Pin staging to an explicit LifeAtlas ZeroClaw image tag.
# Avoid :latest for staging/prod rollouts.
ZEROCLAW_IMAGE=ghcr.io/thdqd/zeroclaw-la-fork:v0.7.3-la.1.1

# Host paths used by the host Docker daemon. The Compose file mounts these into
# the proxy as /zeroclaw-data and /admin-data.
ZEROCLAW_HOST_DATA_DIR=/Users/jahanvi/claw-auth-proxy/data/zeroclaw
ADMIN_HOST_DATA_DIR=/Users/jahanvi/claw-auth-proxy/data/admin


# Shared Docker network used by the proxy and per-user ZeroClaw containers.
ZEROCLAW_NETWORK_NAME=lifeatlas-net

# Lifecycle cleanup.
LIFECYCLE_CHECK_INTERVAL_MINUTES=60
INACTIVE_CONTAINER_DAYS=30

# LifeAtlas file tools: inline extracted-text preview before full=true is needed.
LIFEATLAS_TEXT_PREVIEW_CHARS=4000

# --- ZeroClaw LLM provider ---
# The proxy injects the key into provider-specific env vars in containers, for
# example ANTHROPIC_API_KEY, OPENAI_API_KEY, or OPENROUTER_API_KEY.
ZEROCLAW_LLM_PROVIDER=openrouter
ZEROCLAW_LLM_MODEL=deepseek/deepseek-v4-flash:free
ZEROCLAW_LLM_API_KEY=your_openrouter_api_key_here


# --- Admin / management plane ---
# Stable HS256 secret for admin session JWTs. Changing it invalidates active
# admin sessions.
ADMIN_JWT_SECRET=your_admin_jwt_secret_here
ADMIN_JWT_TTL_SECONDS=1800
ADMIN_AUDIT_RETENTION_DAYS=90

# WebAuthn/passkey settings must match the browser-visible proxy origin exactly.
# RP ID is a hostname only, no scheme or port.
ADMIN_WEBAUTHN_RP_ID=localhost
ADMIN_WEBAUTHN_RP_NAME=Claw Admin Local
ADMIN_WEBAUTHN_ORIGIN=http://localhost:8000

# In Compose these are set to container paths by docker-compose.yml. Override
# only for non-Compose/dev runs.
# ADMIN_DATA_DIR=data/admin
# ZEROCLAW_DATA_DIR=/data/zeroclaw
# ZEROCLAW_TEMPLATES_DIR=/app/templates
# ZEROCLAW_NETWORK_MODE=shared
# ZEROCLAW_PUSH_WEBHOOK_BASE_URL=http://claw-proxy:8000
# USER_CONFIG_ALLOWLIST_PATH=data/user_config_allowlist.toml

# Optional admin CLI defaults for operators running claw-admin from this host.
# CLAW_ADMIN_API_URL=https://claw-proxy-staging.example.com
# CLAW_ADMIN_TOKEN_FILE=~/.config/claw-admin/token
